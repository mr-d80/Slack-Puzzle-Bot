# Copy to .env and fill in your own values. Never commit .env or credentials.
# Deployment environment variables take precedence over this file.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SCORE_CHANNEL_ID=
SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=json/service-account.json

# IANA timezone names. Set both to your group's local timezone.
TZ_NAME=America/Vancouver
SCORE_DAY_TZ_NAME=America/Vancouver
# Initial fallback; after the first day, yesterday's participants determine this.
PLAYERS_EXPECTED=4
# Optional comma-separated Slack user IDs allowed to run BOTH slash commands.
# Blank allows all members who invoke a command in the configured score channel.
ADMIN_USER_IDS=

POST_DAILY_RECAP=1
DAILY_RECAP_IN_THREAD=1
POST_MONTHLY_SUMMARY=1
MONTHLY_SUMMARY_IN_THREAD=1
POST_MONTHLY_PLAYER_BREAKDOWNS=1
MONTHLY_SUMMARY_MAX_AGE_DAYS=14
NL_QUERY_ENABLED=1
NL_QUERY_IN_THREAD=1

# Medal scoring applies to score days on/after this date. Do not change after
# recording results without planning a ledger migration.
MEDAL_SCORING_START=2026-10-01

# Optional AI. Recaps and supported rule-based questions work without a key.
# Setting a key also enables AI translation of other natural-language questions.
AI_REWRITE_ENABLED=0
OPENAI_API_KEY=

# AI models. The recap default is gpt-5-mini. Blank OPENAI_NL_MODEL inherits
# OPENAI_MODEL for natural-language questions; set it to use a separate model.
OPENAI_MODEL=gpt-5-mini
OPENAI_NL_MODEL=
# auto | responses | chat. In auto mode, recaps select by model family;
# natural-language queries try Responses, then Chat on HTTP 404/405.
OPENAI_API_MODE=auto
# Blank uses the code's model-family default: minimal for GPT-5 names,
# low for GPT-6 names, otherwise unspecified. Explicit values override this.
OPENAI_REASONING_EFFORT=
# Output-token cap for daily AI rewrites. Monthly recaps use the larger of
# these two caps. Natural-language queries have a separate fixed 350-token cap.
OPENAI_MAX_TOKENS=220
OPENAI_MAX_TOKENS_MONTHLY=700
# basic | flair. Flair requests lively sports-announcer commentary.
AI_RECAP_STYLE=basic
# low | medium | high. Applies to flair recaps through the Responses API;
# basic recaps and Chat requests do not send this setting.
OPENAI_TEXT_VERBOSITY=high

# Comma-separated games excluded from the tightest-race metric, with or
# without AI. Omitted defaults to Pinpoint; explicitly blank excludes none.
TIGHTEST_RACE_EXCLUDE_GAMES=Pinpoint
